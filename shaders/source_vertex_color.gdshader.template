shader_type spatial;
render_mode __RENDER_MODES__;

__DEFINES__
uniform vec4 uSourceAlbedo : source_color = vec4(1.0);
uniform float uSourceRoughness = 1.0;
uniform float uSourceMetallic = 0.0;
uniform float uSourceSpecular = 0.5;
#ifdef SOURCE_TEXTURE
uniform sampler2D uSourceTexture : source_color, __SAMPLER__;
#endif
#ifdef SOURCE_EMISSION
uniform vec4 uSourceEmission : source_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform float uSourceEmissionEnergy = 1.0;
#endif
#ifdef SOURCE_ALPHA_SCISSOR
uniform float uSourceAlphaScissor = 0.5;
#endif

#ifdef SOURCE_FLOAT_COLOR
varying vec4 sourceVertexColor;
#endif

vec3 sourceDecode(vec3 color) {
  return mix(pow((color + vec3(0.055)) / 1.055, vec3(2.4)), color / 12.92, lessThan(color, vec3(0.04045)));
}

vec3 sourceEncode(vec3 color) {
  return mix(1.055 * pow(max(color, vec3(0.0)), vec3(1.0 / 2.4)) - vec3(0.055), color * 12.92, lessThan(color, vec3(0.0031308)));
}

// Compatibility treats ALBEDO as sRGB, decodes it with this cubic and presents with
// a toeless power curve, while source colours multiply linearly. Invert the cubic so
// shading receives the source's linear value; it has no real inverse below zero.
vec3 sourceCompatAlbedo(vec3 target) {
  vec3 value = max(sourceEncode(target), vec3(0.0));
  for (int step = 0; step < 4; step++) {
    vec3 decoded = value * (value * (value * 0.305306011 + 0.682171111) + 0.012522878);
    value -= (decoded - target) / (value * (value * 0.915918033 + 1.364342222) + 0.012522878);
  }
  return mix(value, max(target / 0.012522878, vec3(-0.0092)), lessThanEqual(target, vec3(0.0)));
}

#ifdef SOURCE_FLOAT_COLOR
void vertex() {
  sourceVertexColor = CUSTOM2;
}
#endif

void fragment() {
  // COLOR is white without ARRAY_COLOR and carries the native instance tint.
  vec4 surface = COLOR;
#ifdef SOURCE_FLOAT_COLOR
  surface *= sourceVertexColor;
#endif
  vec3 base = OUTPUT_IS_SRGB ? sourceDecode(uSourceAlbedo.rgb) : uSourceAlbedo.rgb;
#ifdef SOURCE_TEXTURE
  vec4 sampled = texture(uSourceTexture, UV);
  base *= OUTPUT_IS_SRGB ? sourceDecode(sampled.rgb) : sampled.rgb;
  surface.a *= sampled.a;
#endif
  vec3 linear = base * surface.rgb;
#ifdef SOURCE_UNSHADED
  // Unlit output reaches the presentation curve directly; keep the sRGB toe too.
  if (OUTPUT_IS_SRGB) {
    linear = pow((max(sourceEncode(linear), vec3(0.0)) + vec3(0.055)) / 1.055, vec3(2.4));
  }
#endif
  ALBEDO = OUTPUT_IS_SRGB ? sourceCompatAlbedo(linear) : linear;
  METALLIC = uSourceMetallic;
  SPECULAR = uSourceSpecular;
  ROUGHNESS = uSourceRoughness;
#ifdef SOURCE_EMISSION
  EMISSION = uSourceEmission.rgb * uSourceEmissionEnergy;
#endif
#ifdef SOURCE_ALPHA
  ALPHA *= uSourceAlbedo.a * surface.a;
#endif
#ifdef SOURCE_ALPHA_SCISSOR
  ALPHA_SCISSOR_THRESHOLD = uSourceAlphaScissor;
#endif
}
